PORT=5000

# Paste your complete MongoDB connection string in Backend/.env.
# Do not commit the real URI or password.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0&retryWrites=true&w=majority

# Python ML engine (Vision/ML/api_server.py). Defaults to http://127.0.0.1:8000 when unset.
# Use 127.0.0.1, not localhost (Node tries IPv6 ::1 first; the Python server is IPv4-only).
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=15000

# Comma-separated list of allowed frontend origins. Leave empty to allow any origin.
CORS_ORIGIN=http://localhost:5173

# AI assistant (#5) — any OpenAI-compatible chat-completions API works here.
# Default below is Groq (free tier, verified working) — get a key at
# console.groq.com, it starts with "gsk_". Model list (in case this one is
# retired): https://console.groq.com/docs/models, or GET /v1/models with
# your key. xAI Grok (https://api.x.ai/v1, key starts "xai-") and OpenAI
# itself are drop-in alternatives — swapping providers is just these 3 lines.
# Leave AI_API_KEY unset to disable the assistant (its endpoint returns a
# clear "not configured" error instead of failing oddly).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
